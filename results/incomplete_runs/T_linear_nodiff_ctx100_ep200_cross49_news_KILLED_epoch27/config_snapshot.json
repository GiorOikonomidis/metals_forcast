      "AA_low",
      "BHP_open",
      "FCX_open",
      "AA_high",
      "RIO_open",
      "AA_close",
      "FCX_Williams_R",
      "FCX_Movement",
      "BHP_Stoch_K",
      "RIO_Williams_R",
      "FCX_MACD",
      "FCX_ROC",
      "FCX_EMA_12",
