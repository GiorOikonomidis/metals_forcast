{
  "seed": 1,
  "data": {
    "target": {
      "id": "SINE_MOD",
      "feature": "close"
    },
    "covariates": null,
    "global_covariates": [
      "FCX_close"
    ],
    "news_col": "embedding",
    "splits": {
      "test_days": 365,
      "val_days": 365
    },
    "pred_len": 7,
    "ctx_len": 30,
    "token_all": false,
    "shuffle_data": true,
    "type_of_diff": "log_diff"
  },
  "model": {
    "comp_enc": "amazon/chronos-t5-small",
    "cross_chronos": {
      "emb_dim_news": 768,
      "d_model": 512,
      "n_heads": 8,
      "n_layers_txt": 3,
      "d_ff": 1024,
      "dropout": 0.25,
      "head": "transformer"
    }
  },
  "training": {
    "epochs": 100,
    "lr": 0.0001,
    "weight_decay": 0.0,
    "grad_clip": null,
    "batch_size": 1024,
    "label_smoothing": 0.0
  },
  "evaluation": {
    "windows": null,
    "mc_samples": 200,
    "central_interval": {
      "alpha_50": 0.5,
      "alpha_80": 0.2,
      "alpha_90": 0.1
    },
    "ece_grid": {
      "start": 0.05,
      "stop": 0.95,
      "steps": 19
    },
    "faith": {
      "mc_samples": 100,
      "ks": [
        1,
        2,
        3,
        5,
        8,
        10,
        15,
        20,
        25,
        30
      ],
      "topk": 5,
      "stability_runs": 5,
      "placebo_shifts": [
        -3,
        -1,
        1,
        3
      ],
      "mask_strategy": "mean",
      "rng_seed": 123
    }
  },
  "scheduler": {
    "use": true,
    "cold_start": 0.0001,
    "cold_epochs": 30,
    "decrease_factor": 0.5,
    "metric": "val",
    "patience": 7
  },
  "early_stopper": {
    "use": true,
    "patience": 10
  },
  "tracking": {
    "mlflow": {
      "use": true,
      "uri": "http://127.0.0.1:5000",
      "experiment": "synthetic",
      "run_name": "sine_mod",
      "log_model": false
    },
    "local": {
      "use": true,
      "dir": "synthetic/sine_mod"
    }
  }
}